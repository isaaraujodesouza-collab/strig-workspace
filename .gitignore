# =====================================================================
# REGRA DESTE WORKSPACE: salvar TUDO.
#
# Só fica de fora o que é (a) segredo ou (b) lixo regenerável.
# Nada de trabalho — cliente, conteúdo, Strig News, marca, dados — entra
# nesta lista. Se você criar uma pasta nova de trabalho, ela já vem salva
# por padrão. Não precisa mexer aqui.
# =====================================================================

# --- SEGREDOS (nunca commitar) ---
.env
.env.local
.env.*
*.pem
*.key
credentials.json
service-account*.json

# --- LIXO REGENERÁVEL ---
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# --- SISTEMA ---
.DS_Store
Thumbs.db
desktop.ini
~$*
